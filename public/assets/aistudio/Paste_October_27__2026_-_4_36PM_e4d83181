const { supabase } = require('../config/supabase');

exports.paymentWebhook = async (req, res) => {
  try {
    const { token_code, status, transaction_id } = req.body; // Simulated provider payload

    if (status !== 'SUCCESSFUL') return res.status(200).send('Ignored');

    // Find pending payment
    const { data: payment } = await supabase.from('payments')
      .select('*').eq('token_code', token_code).eq('status', 'pending').single();

    if (!payment) return res.status(200).send('Already processed');

    // 1. Calculate Split (5% VAT, 70/30)
    const amount = Number(payment.amount);
    const vat = amount * 0.05;
    const afterVat = amount - vat;
    const artistShare = afterVat * 0.70;
    const ownerShare = afterVat * 0.30;

    // 2. Update Payment
    await supabase.from('payments').update({
      status: 'paid',
      provider_transaction_id: transaction_id,
      vat_amount: vat,
      artist_share: artistShare,
      owner_share: ownerShare,
      completed_at: new Date().toISOString()
    }).eq('id', payment.id);

    // 3. Create Purchase (Grants access)
    await supabase.from('purchases').insert([{
      user_id: payment.user_id,
      video_id: payment.video_id,
      payment_id: payment.id,
      amount_paid: amount,
      artist_share: artistShare,
      owner_share: ownerShare,
      receipt_number: token_code
    }]);

    // 4. Credit Artist Wallet
    const { data: wallet } = await supabase.from('artist_wallet').select('balance').eq('artist_id', payment.artist_id).single();
    if (wallet) {
      await supabase.from('artist_wallet').update({ balance: Number(wallet.balance) + artistShare }).eq('artist_id', payment.artist_id);
    } else {
      await supabase.from('artist_wallet').insert([{ artist_id: payment.artist_id, balance: artistShare }]);
    }

    res.status(200).send('Webhook processed');
  } catch (err) {
    console.error(err);
    res.status(500).send('Error');
  }
};
