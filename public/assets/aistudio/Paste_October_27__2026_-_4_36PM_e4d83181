const { supabase } = require('../config/supabase');

// Toggle Like
exports.toggleLike = async (req, res) => {
  try {
    const { videoId } = req.params;
    const userId = req.userId;

    const { data: existing } = await supabase.from('user_likes').select('id').eq('user_id', userId).eq('video_id', videoId).single();

    if (existing) {
      await supabase.from('user_likes').delete().eq('id', existing.id);
      // Decrement video likes
      const { data: v } = await supabase.from('videos').select('likes').eq('id', videoId).single();
      await supabase.from('videos').update({ likes: Math.max(0, (v.likes || 0) - 1) }).eq('id', videoId);
      return res.json({ liked: false });
    } else {
      await supabase.from('user_likes').insert([{ user_id: userId, video_id: videoId }]);
      // Increment video likes
      const { data: v } = await supabase.from('videos').select('likes').eq('id', videoId).single();
      await supabase.from('videos').update({ likes: (v.likes || 0) + 1 }).eq('id', videoId);
      return res.json({ liked: true });
    }
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};

// Get Comments
exports.getComments = async (req, res) => {
  try {
    const { videoId } = req.params;
    const { data } = await supabase.from('user_comments')
      .select('*, users(full_name, email)')
      .eq('video_id', videoId)
      .eq('is_hidden', false)
      .order('created_at', { ascending: false });
    res.json(data || []);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};

