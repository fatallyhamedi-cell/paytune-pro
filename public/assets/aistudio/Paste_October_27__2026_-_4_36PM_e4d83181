    const vid = videoRef.current;
    if (!vid) return;

    // Load saved progress
    const loadProgress = async () => {
      try {
        const res = await api.get(`/videos/${video.id}/progress`);
        if (res.data.position_seconds) vid.currentTime = res.data.position_seconds;
      } catch (err) {}
    };
    loadProgress();

    // Save progress every 5 seconds
    const interval = setInterval(() => {
      if (!vid.paused && vid.currentTime > 0) {
        api.post('/videos/progress', { videoId: video.id, positionSeconds: vid.currentTime }).catch(() => {});
      }
    }, 5000);

    return () => clearInterval(interval);
  }, [video.id]);

  const handleTimeUpdate = () => {
    const vid = videoRef.current;
    // 30-second paywall logic
    if (!userOwns && !video.is_free && vid.currentTime >= 30) {
      vid.pause();
