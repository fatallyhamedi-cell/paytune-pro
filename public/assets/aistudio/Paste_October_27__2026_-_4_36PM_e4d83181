const { supabase } = require('../config/supabase');

// GET /api/ads/video/:videoId
exports.getAdForVideo = async (req, res) => {
  try {
    const { videoId } = req.params;

    // 1. Check if the video is Free (Ads NEVER play on Paid videos)
    const { data: video } = await supabase.from('videos')
      .select('is_free, is_short')
      .eq('id', videoId)
      .single();

    if (!video || !video.is_free || video.is_short) {
      return res.json({ ad: null }); // No ads for paid videos or Shorts
    }

    // 2. Fetch a global active ad (or specific to this video)
    const { data: assignments } = await supabase.from('ad_assignments')
      .select('ads(*)')
      .eq('status', 'active')
      .or(`scope.eq.global,video_id.eq.${videoId}`)
      .limit(1);

    if (assignments && assignments.length > 0) {
      return res.json({ ad: assignments[0].ads });
    }

    res.json({ ad: null });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};
