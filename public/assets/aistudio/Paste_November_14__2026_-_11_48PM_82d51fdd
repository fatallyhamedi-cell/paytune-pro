A. The Media Upload Controller (mediaController.ts)
This controller validates the file, uploads to Supabase Storage, and creates the database record.

typescript
import { Request, Response } from 'express';
import { supabase } from '../config/supabase'; // Uses SERVICE_ROLE key
import { v4 as uuidv4 } from 'uuid';

export const uploadMedia = async (req: Request, res: Response) => {
  try {
    const { artistId, contentType, title, description, isPaid, price } = req.body;
    const file = req.file; // Assuming multer is used
    
    // 1. Authorization: Verify the user is an owner/manager of this artist
    const { data: membership, error: authError } = await supabase
      .from('artist_members')
      .select('role')
      .eq('artist_id', artistId)
      .eq('user_id', req.user.id) // req.user set by JWT middleware
      .in('role', ['owner', 'manager'])
      .single();

    if (authError || !membership) {
      return res.status(403).json({ error: 'Unauthorized to upload for this artist.' });
    }

    if (!file) return res.status(400).json({ error: 'No file provided.' });

    // 2. Upload to Supabase Storage (Private Bucket)
    const fileExt = file.originalname.split('.').pop();
    const fileName = `${artistId}/${uuidv4()}.${fileExt}`;
    
    const { data: uploadData, error: uploadError } = await supabase.storage
      .from('media_assets')
      .upload(fileName, file.buffer, {
        contentType: file.mimetype,
        upsert: false
      });

    if (uploadError) throw uploadError;

    // 3. Save Metadata to Database
    const { data: mediaRecord, error: dbError } = await supabase
      .from('media_content')
      .insert({
        artist_id: artistId,
        content_type: contentType,
        title,
        description,
        media_url: uploadData.path, // Store the path, not the public URL
        is_paid: isPaid,
        price: price || 0,
        status: 'published' // Or 'processing' if you use FFmpeg
      })
      .select()
      .single();

    if (dbError) throw dbError;

    res.status(201).json({ message: 'Upload successful', media: mediaRecord });
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
};
