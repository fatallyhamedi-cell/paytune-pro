CREATE OR REPLACE FUNCTION process_media_purchase(
    p_user_id UUID,
    p_artist_id UUID,
    p_media_id UUID,
    p_amount NUMERIC
) RETURNS public.ledger_transactions AS $$
DECLARE
    v_transaction public.ledger_transactions;
    v_platform_fee NUMERIC;
    v_artist_share NUMERIC;
BEGIN
    -- 1. Check if user already owns it (Prevent double purchase)
    IF EXISTS (
        SELECT 1 FROM public.ledger_transactions 
        WHERE user_id = p_user_id AND reference_id = p_media_id AND status = 'cleared'
    ) THEN
        RAISE EXCEPTION 'User already owns this media.';
    END IF;

    -- 2. Calculate 70/30 split
    v_platform_fee := p_amount * 0.30;
    v_artist_share := p_amount * 0.70;

    -- 3. Insert the User's Purchase Transaction
    INSERT INTO public.ledger_transactions (user_id, artist_id, transaction_type, amount, status, reference_id)
    VALUES (p_user_id, p_artist_id, 'video_purchase', p_amount, 'cleared', p_media_id)
    RETURNING * INTO v_transaction;

    -- 4. Insert the Artist's Earning (Pending state for escrow)
    INSERT INTO public.ledger_transactions (artist_id, transaction_type, amount, status, reference_id)
    VALUES (p_artist_id, 'ad_revenue', v_artist_share, 'pending', p_media_id);

    -- Note: Payment gateway integration (MoMo/Stripe) would happen here via backend webhook.

    RETURN v_transaction;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;
