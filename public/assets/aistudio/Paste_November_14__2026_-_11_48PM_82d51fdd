// frontend/src/components/CustomVideoPlayer.tsx
import { useState, useRef, useEffect } from 'react';
import { Play, Pause, RotateCcw, RotateCw, Volume2, VolumeX, Settings, Maximize, Subtitles, Cast, PictureInPicture } from 'lucide-react';

interface VideoPlayerProps {
  videoUrl: string;
  posterUrl: string;
  hasPurchased: boolean;
  price: number;
  onBuy: () => void;
}

export default function CustomVideoPlayer({ videoUrl, posterUrl, hasPurchased, price, onBuy }: VideoPlayerProps) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const [isPlaying, setIsPlaying] = useState(false);
  const [currentTime, setCurrentTime] = useState(0);
  const [duration, setDuration] = useState(0);
  const [volume, setVolume] = useState(1);
  const [isMuted, setIsMuted] = useState(false);

  // Toggle Play/Pause
  const togglePlay = () => {
    if (!hasPurchased) return; // Block play if not purchased
    if (videoRef.current?.paused) {
      videoRef.current.play();
      setIsPlaying(true);
    } else {
      videoRef.current?.pause();
      setIsPlaying(false);
    }
  };

  // Skip 10s
  const skip = (amount: number) => {
    if (videoRef.current) {
      videoRef.current.currentTime += amount;
    }
  };

  // Handle Seek
  const handleSeek = (e: React.ChangeEvent<HTMLInputElement>) => {
    const time = Number(e.target.value);
    setCurrentTime(time);
    if (videoRef.current) videoRef.current.currentTime = time;
  };

  // Format Time (e.g., 08:28)
  const formatTime = (time: number) => {
    const mins = Math.floor(time / 60);
    const secs = Math.floor(time % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  };

  return (
    <div className="relative w-full aspect-video bg-black md:rounded-xl overflow-hidden group">
      
      {/* VIDEO ELEMENT */}
      <video
        ref={videoRef}
        src={videoUrl}
        poster={posterUrl}
        playsInline
        onClick={togglePlay}
        onTimeUpdate={(e) => setCurrentTime(e.currentTarget.currentTime)}
        onLoadedMetadata={(e) => setDuration(e.currentTarget.duration)}
        className={`w-full h-full object-contain ${!hasPurchased ? 'opacity-30 blur-sm' : ''}`}
      />

      {/* PAYTUNE WATERMARK (Bottom Right, hidden when controls appear) */}
      <div className={`absolute bottom-16 right-4 pointer-events-none transition-opacity duration-300 ${isPlaying ? 'opacity-40' : 'opacity-80'}`}>
        <span className="text-white font-bold text-lg tracking-wider drop-shadow-md flex items-center gap-1">
          <div className="w-4 h-4 bg-[#8B5CF6] rounded-sm"></div> PayTune
        </span>
      </div>

      {/* PAYWALL OVERLAY */}
      {!hasPurchased && (
        <div className="absolute inset-0 flex flex-col items-center justify-center bg-black/40">
          <h2 className="text-white text-2xl font-bold mb-2 flex items-center gap-2">
            <span className="w-6 h-6 bg-red-600 rounded-full flex items-center justify-center text-sm">!</span>
            Unlock access to watch
          </h2>
          <p className="text-gray-300 mb-6">Available on PayTune Premium</p>
          <button onClick={onBuy} className="bg-[#8B5CF6] hover:bg-purple-700 text-white px-8 py-2 rounded-full font-bold transition">
            Buy for {price} RWF
          </button>
        </div>
      )}

      {/* CUSTOM CONTROLS (Hidden if paywall is active) */}
      {hasPurchased && (
        <div className="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/90 to-transparent px-4 pb-3 pt-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          
          {/* PROGRESS BAR */}
          <div className="flex items-center gap-3 mb-2">
            <input
              type="range"
              min={0}
              max={duration || 0}
              value={currentTime}
              onChange={handleSeek}
              className="w-full h-1 bg-gray-600 rounded appearance-none cursor-pointer accent-[#8B5CF6]"
            />
          </div>

          {/* CONTROLS ROW */}
          <div className="flex items-center justify-between text-white">
            <div className="flex items-center gap-4">
              <button onClick={togglePlay} className="hover:text-[#8B5CF6]">
                {isPlaying ? <Pause size={24} fill="currentColor" /> : <Play size={24} fill="currentColor" />}
              </button>
              <button onClick={() => skip(-10)} className="hover:text-[#8B5CF6] relative">
                <RotateCcw size={20} />
                <span className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[8px] font-bold">10</span>
              </button>
              <button onClick={() => skip(10)} className="hover:text-[#8B5CF6] relative">
                <RotateCw size={20} />
                <span className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[8px] font-bold">10</span>
              </button>
              <div className="flex items-center gap-2 group/volume">
                <button onClick={() => { setIsMuted(!isMuted); if (videoRef.current) videoRef.current.muted = !isMuted; }}>
                  {isMuted || volume === 0 ? <VolumeX size={20} /> : <Volume2 size={20} />}
                </button>
                <input
                  type="range"
                  min={0} max={1} step={0.1}
                  value={isMuted ? 0 : volume}
                  onChange={(e) => {
                    const val = Number(e.target.value);
                    setVolume(val);
                    setIsMuted(val === 0);
                    if (videoRef.current) { videoRef.current.volume = val; videoRef.current.muted = val === 0; }
                  }}
                  className="w-0 group-hover/volume:w-20 transition-all duration-300 h-1 bg-gray-600 rounded appearance-none accent-[#8B5CF6]"
                />
              </div>
              <span className="text-xs text-gray-300 font-medium">
                {formatTime(currentTime)} / {formatTime(duration)}
              </span>
            </div>

            <div className="flex items-center gap-4">
              <button className="hover:text-[#8B5CF6]"><Subtitles size={20} /></button>
              <button className="hover:text-[#8B5CF6]"><Settings size={20} /></button>
              <button className="hover:text-[#8B5CF6]"><PictureInPicture size={20} /></button>
              <button onClick={() => videoRef.current?.requestFullscreen()} className="hover:text-[#8B5CF6]">
                <Maximize size={20} />
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
