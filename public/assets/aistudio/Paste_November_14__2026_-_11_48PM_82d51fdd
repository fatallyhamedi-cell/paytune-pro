import { Request, Response } from 'express';
import { supabase } from '../config/supabase';

export const purchaseMedia = async (req: Request, res: Response) => {
  const { mediaId } = req.body;
  const userId = req.user.id;

  try {
    // 1. Fetch media details and verify price
    const { data: media, error: mediaError } = await supabase
      .from('media_content')
      .select('id, artist_id, price, is_paid')
      .eq('id', mediaId)
      .single();

    if (mediaError || !media) return res.status(404).json({ error: 'Media not found.' });
    if (!media.is_paid) return res.status(400).json({ error: 'This media is free.' });

    // 2. Call a Supabase RPC (PostgreSQL Function) to handle the transaction safely
    // This prevents race conditions and double-charging.
    const { data: transaction, error: txError } = await supabase.rpc('process_media_purchase', {
      p_user_id: userId,
      p_artist_id: media.artist_id,
      p_media_id: mediaId,
      p_amount: media.price
    });

    if (txError) throw txError;

    // 3. Generate a Signed URL for secure playback (Valid for 2 hours)
    const { data: signedUrlData, error: urlError } = await supabase.storage
      .from('media_assets')
      .createSignedUrl(media.media_url, 7200); 

    if (urlError) throw urlError;

    res.status(200).json({
      message: 'Purchase successful',
      playbackUrl: signedUrlData.signedUrl,
      transactionId: transaction.id
    });

  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
};
C. The Database Function (process_media_purchase)
You must run this SQL in Supabase to ensure the money moves safely.

