CREATE TABLE purchases (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT UNSIGNED NOT NULL,
    video_id BIGINT UNSIGNED NOT NULL,
    order_id BIGINT UNSIGNED NOT NULL UNIQUE,
    purchase_price BIGINT UNSIGNED NOT NULL,
    currency CHAR(3) NOT NULL,
    status ENUM('active','refunded','revoked')
        NOT NULL DEFAULT 'active',
    purchased_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (video_id) REFERENCES videos(id),
    FOREIGN KEY (order_id) REFERENCES orders(id),
    UNIQUE KEY uq_user_video_purchase (user_id, video_id),
    INDEX idx_purchase_library (user_id, status, purchased_at)
) ENGINE=InnoDB;

CREATE TABLE entitlements (
    id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT UNSIGNED NOT NULL,
    video_id BIGINT UNSIGNED NOT NULL,
    purchase_id BIGINT UNSIGNED NOT NULL UNIQUE,
    granted_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    expires_at DATETIME NULL,
    status ENUM('active','suspended','revoked')
        NOT NULL DEFAULT 'active',
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (video_id) REFERENCES videos(id),
    FOREIGN KEY (purchase_id) REFERENCES purchases(id),
    UNIQUE KEY uq_user_video_entitlement (user_id, video_id),
    INDEX idx_entitlement_check (user_id, video_id, status)
) ENGINE=InnoDB;



Important implementation notes:
- Create and update purchases and entitlements inside a transaction after the payment is verified.
- Treat expires_at = NULL as no scheduled expiration.
- The unique user/video constraints prevent multiple ownership records. Your checkout service should check existing ownership before attempting payment.
- A refunded or revoked entitlement requires an explicit policy-driven state transition; never silently delete the purchase history.
- For a production system, handle duplicate-key conflicts safely, especially when payment callbacks arrive simultaneously.
- Use migrations to apply schema changes. Test the schema and business rules against the exact MySQL version you deploy.
